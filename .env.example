# Copy this file to .env and set the Web OAuth client ID from Google Cloud Console.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Create a Meta app with Facebook Login and keep the App Secret on the server only.
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# Optional one-time bootstrap: set to an existing, verified SignSpeak account's email.
# Leave unset until that account has registered and verified its email address.
# SUPER_ADMIN_EMAIL=admin@example.com

# Optional LAN testing: expose both the API and Vite to other devices on this network.
# For mobile camera/microphone access, use a certificate trusted by the mobile device.
# HOST=0.0.0.0
# DEV_TLS_CERT_PATH=C:\certs\signspeak.crt
# DEV_TLS_KEY_PATH=C:\certs\signspeak.key
# TRUST_PROXY=1
